{
  "name": "india-all-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "server/src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --config client/vite.config.js client",
    "build": "vite build --config client/vite.config.js client && npm --prefix server install --omit=dev",
    "start": "node server/src/server.js",
    "preview": "vite preview --config client/vite.config.js client --host 0.0.0.0"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "sharp": "^0.35.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}