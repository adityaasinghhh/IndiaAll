# Backend environment. Copy to .env and fill in real values. Never commit it.
#
# On Vercel every variable below must be added in the dashboard under
# Project → Settings → Environment Variables. A local .env is not deployed.

# Server
PORT=5000
NODE_ENV=development

# MongoDB — local or Atlas, e.g.:
# mongodb://localhost:27017/indiaall
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/indiaall
# Vercel cannot reach a local MongoDB: use a hosted cluster (MongoDB Atlas).
MONGO_URI=mongodb://localhost:27017/indiaall

# JWT secrets — long, random, independent values in production
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Encrypts the TOTP (MFA) secrets at rest. 32 random bytes, base64 encoded.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

# Frontend origin allowed by CORS (the public website)
CLIENT_URL=http://localhost:3000

# SMTP (email notifications for enquiries / bulk orders)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Info@indiaall.org
# Comma-separated inboxes that receive enquiry notifications
ENQUIRY_RECIPIENTS=Info@indiaall.org

# Initial administrator (used by `npm run seed`). Change immediately.
ADMIN_EMAIL=Info@indiaall.org
ADMIN_PASSWORD=changeme123

# Public contact details
WHATSAPP_NUMBER=15551234567
DATA_RETENTION_DAYS=365

# Maintenance mode flag and the shared secret used to preview the site while
# maintenance mode is on.
MAINTENANCE_MODE=false
MAINTENANCE_PREVIEW_SECRET=india-all-preview

# AI (OpenAI) chatbot — set OPENAI_API_KEY to enable the AI assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini — set GEMINI_API_KEY to enable the AI assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
