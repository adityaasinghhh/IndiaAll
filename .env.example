# Frontend environment (loaded by Vite; only VITE_* values are public)
# Copy to .env and adjust. Never commit the real .env.

# Where the browser should reach the API. Default uses the Vite dev proxy
# (/api -> http://localhost:5000). Set an absolute origin in production.
VITE_API_BASE_URL=/api/v1

# Maintenance mode for the PUBLIC website (the admin panel stays reachable).
VITE_MAINTENANCE_MODE=false

# ---------------------------------------------------------------------------
# Server (backend) environment — copy to server/.env and adjust. Never commit
# the real .env or any actual secret.
# ---------------------------------------------------------------------------

# OpenAI API key used ONLY by the server to call the chat assistant.
# Required for the POST /api/v1/chat endpoint to return real AI responses.
OPENAI_API_KEY=

# Chat model. Defaults to gpt-4o-mini when unset.
OPENAI_MODEL=gpt-4o-mini

# Backend
PORT=5000
NODE_ENV=development

# MongoDB — local or Atlas, e.g.:
# mongodb://localhost:27017/indiaall
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/indiaall
MONGO_URI=mongodb://localhost:27017/indiaall

# JWT secrets — long, random, independent values in production
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Frontend origin allowed by CORS (the public website)
CLIENT_URL=http://localhost:3000

# SMTP (email notifications for enquiries / bulk orders)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Info@indiaall.org
# Comma-separated inboxes that receive enquiry notifications
ENQUIRY_RECIPIENTS=Info@indiaall.org

# Initial administrator (used by `npm run seed`). Change immediately.
ADMIN_EMAIL=Info@indiaall.org
ADMIN_PASSWORD=changeme123

# Public contact details
WHATSAPP_NUMBER=15551234567
DATA_RETENTION_DAYS=365

# AI (OpenAI) chatbot — set OPENAI_API_KEY to enable the AI assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1