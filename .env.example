# ─────────────────────────────────────────────────────────────────────────────
# INDIA ALL — example environment file
#
# Copy to `.env` (repository root) for local development and to
# `server/.env` for the backend, then fill in real values. Never commit the
# real .env — it is ignored by .gitignore.
#
# IMPORTANT FOR VERCEL: a .env file on your computer is NOT available on
# Vercel. Every variable below that the app needs must be added in the
# Vercel dashboard under Project → Settings → Environment Variables.
# Only variables prefixed with VITE_ are ever visible to browser code.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (Vite) — only VITE_* values reach the browser ─────────────────
# Where the browser should reach the API.
# Keep this RELATIVE: the frontend and the API are served from the same
# domain on Vercel (the API lives behind the /api/* rewrite), so the browser
# makes same-origin requests and no CORS setup is needed.
# In local development the Vite dev server proxies /api to the backend
# (see client/vite.config.js).
VITE_API_BASE_URL=/api/v1

# Maintenance mode for the PUBLIC website (the admin panel stays reachable).
# NOTE: the current build does not read this variable yet — the maintenance
# banner is currently driven by the Maintenance screen in the admin portal.
VITE_MAINTENANCE_MODE=false

# ── Backend (Express) ───────────────────────────────────────────────────────

# Backend
PORT=5000
NODE_ENV=development

# MongoDB — local or Atlas, e.g.:
# mongodb://localhost:27017/indiaall          <- local development only
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/indiaall
# Vercel cannot reach a local MongoDB: use a hosted cluster (MongoDB Atlas).
MONGO_URI=mongodb://localhost:27017/indiaall

# JWT secrets — long, random, independent values in production
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Encrypts the TOTP (MFA) secrets at rest. 32 random bytes, base64 encoded.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it, MFA enrolment is disabled and the server fails safely.
MFA_ENCRYPTION_KEY=

# Frontend origin allowed by CORS (the public website).
# On Vercel set this to your real domain, e.g. https://indiaall.org
CLIENT_URL=http://localhost:3000

# SMTP (email notifications for enquiries / bulk orders)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Info@indiaall.org
# Comma-separated inboxes that receive enquiry notifications
ENQUIRY_RECIPIENTS=Info@indiaall.org

# Initial administrator (used by `npm run seed`). Change immediately.
ADMIN_EMAIL=Info@indiaall.org
ADMIN_PASSWORD=changeme123

# Public contact details
WHATSAPP_NUMBER=15551234567
DATA_RETENTION_DAYS=365

# Maintenance mode flag and the shared secret used to preview the site while
# maintenance mode is on.
MAINTENANCE_MODE=false
MAINTENANCE_PREVIEW_SECRET=india-all-preview
